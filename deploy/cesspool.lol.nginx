# cesspool.lol: static files rendered once a minute by tools/update.py.
# The API under /api/: a zone of its own (nginx.conf already has one named api), and a cache header by
# status, so a 429 or a 405 is never kept by a cache.
limit_req_zone $binary_remote_addr zone=cesspool_api:1m rate=30r/m;
map $status $cesspool_api_cache {
    200 "public, max-age=60";
    206 "public, max-age=60";
    304 "public, max-age=60";
    default "no-store";
}
server {
    listen 80;
    listen [::]:80;
    server_name cesspool.lol www.cesspool.lol;
    location ^~ /.well-known/acme-challenge/ { root /var/www/cesspool.lol; }
    location / { return 301 https://cesspool.lol$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.cesspool.lol;
    ssl_certificate /etc/letsencrypt/live/cesspool.lol/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cesspool.lol/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    ssl_client_certificate /etc/ssl/cloudflare-origin-pull-ca.pem;
    ssl_verify_client on;
    return 301 https://cesspool.lol$request_uri;
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cesspool.lol;
    root /var/www/cesspool.lol;
    index index.html;
    error_page 404 /404.html;
    ssl_certificate /etc/letsencrypt/live/cesspool.lol/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cesspool.lol/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Only Cloudflare reaches the origin. Authenticated Origin Pulls must be ON
    # for the cesspool.lol zone before this is reloaded.
    ssl_client_certificate /etc/ssl/cloudflare-origin-pull-ca.pem;
    ssl_verify_client on;

    include /etc/nginx/cloudflare-ips.conf;
    real_ip_header CF-Connecting-IP;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # Static pages, no inline scripts. Inline styles carry bar widths. The
    # transaction page fetches its data from /d/ on this origin.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    # /tx/<txid> is the transaction page; site.js reads the txid from the path.
    rewrite "^/tx/[0-9a-fA-F]{64}/?$" /tx/index.html last;

    location /static/ {
        add_header Cache-Control "public, max-age=86400" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'" always;
    }
    # Transaction data for /tx/, stored only as .json.gz and served as JSON.
    location /d/ {
        gzip_static always;
        gunzip on;
        default_type application/json;
        add_header Cache-Control "public, max-age=60" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'" always;
    }
    # The read-only API (cesspool/api.py). The address limited is the visitor's, from CF-Connecting-IP
    # above: 30 requests a minute each, and up to 60 more at once. No CORS header: a pool's server
    # reads it, not its visitors' browsers.
    location /api/ {
        limit_req zone=cesspool_api burst=60 nodelay;
        limit_req_status 429;
        default_type application/json;
        add_header Cache-Control $cesspool_api_cache always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'" always;
        try_files $uri @api404;
    }
    # A height not graded here: a JSON 404, not the HTML page.
    location @api404 {
        types { }
        default_type application/json;
        add_header Cache-Control "public, max-age=60" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'" always;
        return 404 '{"error":"not found"}\n';
    }
    location /og/ {
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location / {
        add_header Cache-Control "public, max-age=60" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        try_files $uri $uri/ =404;
    }
    location ~ /\. { return 404; }
}
